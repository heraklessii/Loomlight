{
  "name": "loomlight",
  "productName": "Loomlight",
  "version": "0.1.0",
  "description": "Free and open-source pixel art editor and animation tool",
  "license": "GPL-3.0-or-later",
  "author": "Loomlight contributors",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "icon": "node scripts/make-icon.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "marketing:demo": "vite-node scripts/marketing/make-demo.ts",
    "marketing:render": "electron scripts/marketing/render.cjs cover && electron scripts/marketing/render.cjs banner && electron scripts/marketing/render.cjs background-tile",
    "marketing:screens": "electron-vite build && node scripts/marketing/screenshots.mjs",
    "marketing:preview": "vite marketing/itch --port 5320 --strictPort"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
